{
	"private": true,
	"scripts": {
		"dev": "NEXT_PUBLIC_COMMIT_SHA=${CF_PAGES_COMMIT_SHA:-$(git rev-parse --short HEAD)} next dev --turbopack",
		"build": "NEXT_PUBLIC_COMMIT_SHA=${CF_PAGES_COMMIT_SHA:-$(git rev-parse --short HEAD)} next build",
		"pages:build": "NEXT_PUBLIC_COMMIT_SHA=${CF_PAGES_COMMIT_SHA:-$(git rev-parse --short HEAD)} opennextjs-cloudflare build",
		"preview": "NEXT_PUBLIC_COMMIT_SHA=${CF_PAGES_COMMIT_SHA:-$(git rev-parse --short HEAD)} opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "NEXT_PUBLIC_COMMIT_SHA=${CF_PAGES_COMMIT_SHA:-$(git rev-parse --short HEAD)} opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "NEXT_PUBLIC_COMMIT_SHA=${CF_PAGES_COMMIT_SHA:-$(git rev-parse --short HEAD)} opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"start": "next start",
		"lint": "eslint .",
		"prettier": "prettier --write ."
	},
	"dependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@opennextjs/cloudflare": "^1.19.11",
		"clsx": "^2.1.1",
		"motion": "^12.41.0",
		"next": "16.2.9",
		"prettier": "^3.8.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-scan": "^0.5.7",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^10.5.0",
		"eslint-config-next": "16.2.9",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.104.0"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
}
